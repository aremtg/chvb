DB_HOST=127.0.0.1
DB_NAME=chvb
DB_USER=root
DB_PASS=
APP_URL=http://localhost/chvb/public
# Déjalo vacío para usar automáticamente la carpeta uploads del proyecto.
UPLOADS_PATH=
APP_KEY=

# --- Respaldos (bin/respaldo.php) ---
# Carpeta donde se guardan los .zip. Ponla en OTRO disco o en una carpeta de red, p. ej. D:\respaldos\chvb
BACKUP_PATH=
# Días que se conservan los respaldos (siempre quedan los 3 más recientes).
BACKUP_RETENTION_DAYS=30
# Solo si mysqldump no está en C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=
